# Supabase (base de données)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (email — https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Adresse expéditrice email : doit être une adresse vérifiée dans Brevo
# (Senders, Domains & Dedicated IPs > Senders).
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="EduSuivi"

# Africa's Talking (SMS — https://account.africastalking.com)
# Utilisez "sandbox" pour tester gratuitement (numéros de test uniquement),
# ou le nom d'utilisateur de votre application en production.
AT_USERNAME=
AT_API_KEY=
# Sender ID / shortcode optionnel (laisser vide pour utiliser l'expéditeur
# générique par défaut d'Africa's Talking).
AT_SENDER_ID=
