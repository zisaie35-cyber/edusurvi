# Supabase (base de données)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (envoi d'email — https://resend.com/api-keys)
RESEND_API_KEY=
# Adresse expéditrice. Utilisez "onboarding@resend.dev" pour tester sans domaine vérifié,
# ou une adresse sur un domaine que vous avez vérifié dans Resend.
RESEND_FROM_EMAIL="EduSuivi <onboarding@resend.dev>"

# Twilio (envoi de SMS — https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio expéditeur, au format international (ex: +15017122661)
TWILIO_FROM_NUMBER=
