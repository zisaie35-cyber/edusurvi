# Supabase (base de données)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (email — https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Adresse expéditrice email : doit être une adresse vérifiée dans Brevo
# (Senders, Domains & Dedicated IPs > Senders).
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="EduSuivi"

# Serveur SMS Kannel maison
# URL complète de l'interface sendsms, ex: https://votre-serveur.tld:13013/cgi-bin/sendsms
# Privilégiez HTTPS (via reverse proxy) — l'API expose user/password dans l'URL.
KANNEL_URL=
KANNEL_USERNAME=
KANNEL_PASSWORD=
# Optionnel : nom/numéro expéditeur, selon la configuration de votre smsc
KANNEL_FROM=
