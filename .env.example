# Supabase (base de données)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (email + SMS — https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Adresse expéditrice email : doit être une adresse vérifiée dans Brevo
# (Senders, Domains & Dedicated IPs > Senders).
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="EduSuivi"
# Nom de l'expéditeur SMS : 11 caractères alphanumériques maximum, pas d'espaces.
BREVO_SMS_SENDER="EduSuivi"
