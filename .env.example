# Supabase (base de données)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (email — https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Adresse expéditrice email : doit être une adresse vérifiée dans Brevo
# (Senders, Domains & Dedicated IPs > Senders).
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="EduSuivi"

# Vonage (SMS — https://dashboard.nexmo.com/settings)
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Nom d'expéditeur (alphanumérique, 11 caractères max). Certains pays
# n'autorisent pas les expéditeurs alphanumériques : si le SMS n'arrive
# pas, essayez un numéro Vonage à la place (Numbers > Buy numbers).
VONAGE_FROM="EduSuivi"
